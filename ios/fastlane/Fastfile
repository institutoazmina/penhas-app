import('../../fastlane/Fastfile')

skip_docs

default_platform(:ios)

platform :ios do

  # Both lanes upload to TestFlight; the target app comes from the GitHub
  # environment (IOS_BUNDLE_ID, IOS_PROVISIONING_PROFILE, PENHAS_BASE_URL):
  #   firebase-distribution -> dev.penhas.testflight.com.br (staging)
  #   production            -> penhas.alphacode.com.br (submitted to review manually in App Store Connect)

  desc 'Staging: upload the dev app to TestFlight'
  lane :staging do
    testflight_distribute
  end

  desc 'Production: upload the store app to TestFlight'
  lane :production do
    testflight_distribute
  end

  desc 'Check that the App Store Connect API key is valid'
  lane :verify_app_store_auth do
    request_api_key
    latest_testflight_build_number(app_identifier: bundle_id)
  end

  private_lane :testflight_distribute do
    request_api_key
    setup_signing

    build_number = next_build_number(latest_testflight_build_number(app_identifier: bundle_id, initial_build_number: 0))
    flutter_build('ios --no-codesign --config-only', build_number)

    build_app(
      scheme: 'Runner',
      configuration: 'Release',
      workspace: "#{$project_path}/ios/Runner.xcworkspace",
      archive_path: "#{$project_path}/build/ios/Runner.xcarchive",
      output_directory: "#{$project_path}/build/ios/Runner",
      export_method: 'app-store',
      xcargs: "PROVISIONING_PROFILE_SPECIFIER='#{lane_context[SharedValues::SIGH_UUID]}'",
    )

    # TESTFLIGHT_GROUPS lists external groups only; internal testers receive
    # builds through automatic distribution configured in App Store Connect.
    groups = ENV['TESTFLIGHT_GROUPS'].to_s.split(',').map(&:strip).reject(&:empty?)
    upload_to_testflight(
      ipa: "#{$project_path}/build/ios/Runner/Runner.ipa",
      changelog: changelog,
      groups: groups,
      distribute_external: groups.any?,
      skip_waiting_for_build_processing: groups.empty?,
    )
  end

  private_lane :setup_signing do
    # Creates a temporary keychain when running on CI (no-op locally).
    setup_ci
    if ENV['CERTIFICATE_PATH']
      import_certificate(
        certificate_path: ENV['CERTIFICATE_PATH'],
        certificate_password: ENV['CERTIFICATE_PWD'],
        keychain_name: 'fastlane_tmp_keychain',
        keychain_password: '',
      )
    end

    get_provisioning_profile(
      app_identifier: bundle_id,
      provisioning_name: ENV['IOS_PROVISIONING_PROFILE'].to_s.empty? ? 'PenhaS AppStore' : ENV['IOS_PROVISIONING_PROFILE'],
      output_path: "#{$project_path}/ios/certificates",
      skip_certificate_verification: true,
    )
  end

  private_lane :request_api_key do
    api_key_json = JSON.parse(File.read(ENV['APPLE_API_KEY_PATH']))

    app_store_connect_api_key(
      key_id: api_key_json['key_id'],
      issuer_id: api_key_json['issuer_id'],
      key_content: api_key_json['key'],
      duration: api_key_json['duration'] || 1200,
      in_house: api_key_json['in_house'] || false,
      is_key_content_base64: true,
    )
  end

  private_lane :bundle_id do
    CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
  end

end
