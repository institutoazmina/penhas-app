import('../../fastlane/Fastfile')

skip_docs

default_platform(:android)

platform :android do

  desc 'Staging: build an APK of the dev app and send it to Firebase App Distribution'
  # FIREBASE_TESTERS (comma-separated e-mails) overrides the default tester group.
  lane :staging do
    # Read by android/app/build.gradle: switches to the dev applicationId and resources.
    ENV['IS_FIREBASE_DISTRIBUTION'] = 'true'

    credentials = ENV['FIREBASE_SERVICE_ACCOUNT_PATH']
    testers = ENV['FIREBASE_TESTERS'].to_s.strip
    app_id = firebase_app_id

    latest = firebase_app_distribution_get_latest_release(
      app: app_id,
      service_credentials_file: credentials,
    )
    flutter_build('apk', next_build_number(latest && latest[:buildVersion]))

    firebase_app_distribution(
      app: app_id,
      android_artifact_type: 'APK',
      android_artifact_path: "#{$project_path}/build/app/outputs/apk/release/app-release.apk",
      release_notes: changelog,
      groups: testers.empty? ? 'androidtestersgroup' : nil,
      testers: testers.empty? ? nil : testers,
      service_credentials_file: credentials,
    )
  end

  desc 'Production: build an AAB and upload it to the Play Store production track as a draft'
  # The release stays as a draft; it is reviewed and rolled out manually in the
  # Play Console (see docs/processo-de-release.md).
  lane :production do
    used_codes = %w[production beta alpha internal].flat_map do |track|
      google_play_track_version_codes(track: track)
    rescue StandardError => e
      UI.important("Could not read track #{track}: #{e.message}")
      []
    end
    flutter_build('appbundle', next_build_number(used_codes.max))

    upload_to_play_store(
      track: 'production',
      release_status: 'draft',
      aab: "#{$project_path}/build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc 'Check that the Play Store credentials are valid'
  lane :verify_play_store_auth do
    validate_play_store_json_key(
      json_key: CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file),
    )
  end

  private_lane :firebase_app_id do
    JSON.parse(File.read("#{$project_path}/android/app/google-services.json"))
        .dig('client', 0, 'client_info', 'mobilesdk_app_id')
  end

end
